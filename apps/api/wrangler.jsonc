{
  "name": "chirp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist"
  },
  "routes": [
    { "pattern": "chirp.arjunkrishna.dev", "custom_domain": true }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b362f339732443fb944ab5d42466b313",
      "localConnectionString": "postgres://chirp:chirp@localhost:55432/chirp"
    }
  ]
}
